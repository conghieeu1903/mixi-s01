:root {
    --text-color-dark: rgb(26, 26, 26);
    --text-color-muted: rgb(92, 92, 92);
    --text-color-light: rgb(255, 255, 255);
    --text-color-outline: rgb(0, 0, 0);
}

.game-text {
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Yokelvision/Yokelvision%20SDF.asset?fileID=11400000&guid=14187c714e966914083f06ed4ce583c3&type=2#Yokelvision SDF");
    -unity-font-style: normal;
    color: var(--text-color-dark);
    padding: 0;
    margin: 0;
}

.game-text--comic-title {
    font-size: 84px;
    color: var(--text-color-light);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--text-color-outline);
    text-shadow: 3px 8px 0px var(--text-color-outline);
}

.game-text--comic-button {
    font-size: 52px;
    color: var(--text-color-light);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--text-color-outline);
    text-shadow: 2px 6px 0px var(--text-color-outline);
}

.game-text--heading {
    font-size: 62px;
}

.game-text--subheading {
    font-size: 46px;
}

.game-text--body {
    font-size: 42px;
}

.game-text--caption {
    font-size: 30px;
    color: var(--text-color-muted);
}
