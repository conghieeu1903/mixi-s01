.settings {
    padding: 64px 240px;
}

.settings__panel {
    flex-grow: 1;
}

.settings__tabs {
    flex-direction: row;
    margin-bottom: 20px;
}

.settings__list {
    flex-grow: 1;
}

.settings__group {
    margin: 8px 0 12px 0;
}

.settings__row {
    padding: 10px 0;
    border-bottom-width: 1px;
    border-color: var(--wf-line-soft);
}

.settings__footer {
    flex-direction: row;
    margin-top: 20px;
}

