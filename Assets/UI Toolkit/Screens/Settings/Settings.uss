/* Nút RESET / APPLY */
.settings__btn {
    position: absolute;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: stretch-to-fill;
    transition-duration: 0.12s;
}

.settings__btn:hover {
    scale: 1.04 1.04;
}

.settings__btn:active {
    scale: 0.96 0.96;
}

.settings__btn--reset {
    left: 520px;
    top: 700px;
    width: 223px;
    height: 66px;
    background-image: url("/Assets/Arts/Sprites/Settings/settings_btn_reset.png");
}

.settings__btn--apply {
    left: 726px;
    top: 677px;
    width: 290px;
    height: 113px;
    background-image: url("/Assets/Arts/Sprites/Settings/settings_btn_apply.png");
}

/* Nút LOGOUT góc dưới trái panel, bấm vào mở hộp xác nhận */
.settings__btn--logout {
    left: 51px;
    top: 700px;
    width: 223px;
    height: 66px;
    background-image: url("/Assets/Arts/Sprites/Settings/settings_btn_reset.png");
    -unity-background-image-tint-color: rgb(248, 113, 113);
}

/* Hộp xác nhận đăng xuất phủ giữa màn hình */
.settings-dialog {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(1, 10, 35, 0.75);
}

.settings-dialog--hidden {
    display: none;
}

.settings-dialog__box {
    width: 760px;
    padding: 48px 56px 40px 56px;
    align-items: center;
    background-image: url("/Assets/Arts/Sprites/Settings/settings_panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-top: 48;
    -unity-slice-right: 48;
    -unity-slice-bottom: 48;
}

.settings-dialog__title {
    margin: 0;
    padding: 0;
    font-size: 48px;
    letter-spacing: 1.1px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Arts/Fonts/Inter/Inter-BlackItalic%20SDF.asset?fileID=11400000&guid=6760fe27ba215f04189cb6a412f07c16&type=2#Inter-BlackItalic SDF");
}

.settings-dialog__message {
    margin: 18px 0 0 0;
    padding: 0;
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.8);
    -unity-font-definition: url("project://database/Assets/Arts/Fonts/Inter/Inter-Medium%20SDF.asset?fileID=11400000&guid=7732124c92e6d4744ad7088a3055cb79&type=2#Inter-Medium SDF");
}

.settings-dialog__row {
    flex-direction: row;
    justify-content: center;
    margin-top: 36px;
}

.settings-dialog__btn {
    position: relative;
    width: 260px;
    height: 72px;
    margin: 0 14px;
}

.settings-dialog__btn:disabled {
    opacity: 0.5;
    scale: 1 1;
}

.settings-dialog__btn--cancel {
    background-image: url("/Assets/Arts/Sprites/Settings/settings_btn_reset.png");
}

.settings-dialog__btn--confirm {
    background-image: url("/Assets/Arts/Sprites/Settings/settings_btn_reset.png");
    -unity-background-image-tint-color: rgb(248, 113, 113);
}

.settings__btn-label {
    margin: 0;
    padding: 0;
    font-size: 26px;
    letter-spacing: 0.8px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Arts/Fonts/Inter/Inter-BlackItalic%20SDF.asset?fileID=11400000&guid=6760fe27ba215f04189cb6a412f07c16&type=2#Inter-BlackItalic SDF");
}

.settings__btn--apply > .settings__btn-label {
    color: rgb(1, 21, 69);
}

.settings__btn--logout > .settings__btn-label,
.settings-dialog__btn--confirm > .settings__btn-label {
    color: rgb(248, 113, 113);
}

/* Gợi ý phím ESC / F góc dưới trái */
.settings__hint {
    position: absolute;
