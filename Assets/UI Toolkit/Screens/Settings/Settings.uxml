<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="../../Components/SettingsRow/SettingsRow.uss" />
    <ui:Style src="Settings.uss" />

    <ui:VisualElement name="settingsRoot" focusable="true" class="settings">
        <ui:VisualElement name="settingsBg" picking-mode="Ignore" class="settings__bg" />
        <ui:VisualElement name="settingsOverlay" picking-mode="Ignore" class="settings__overlay" />
        <ui:VisualElement name="settingsCharacter" picking-mode="Ignore" class="settings__character" />

        <SafeAreaContainer name="settingsSafeArea">
            <ui:VisualElement name="titleBg" picking-mode="Ignore" class="settings__title-bg" />
            <ui:Label name="settingsTitle" text="SETTINGS" picking-mode="Ignore" class="settings__text settings__title" />
            <ui:Label name="settingsSubtitle" text="CUSTOMIZE YOUR EXPERIENCE" picking-mode="Ignore" class="settings__text settings__subtitle" />

            <ui:VisualElement name="settingsPanel" picking-mode="Ignore" class="settings__panel">
                <ui:VisualElement picking-mode="Ignore" class="settings__accent settings__accent--yellow" />
                <ui:VisualElement picking-mode="Ignore" class="settings__accent settings__accent--cyan" />

                <ui:VisualElement name="tabAudio" class="settings-tab settings-tab--active settings-tab--1">
                    <ui:Label text="AUDIO" picking-mode="Ignore" class="settings-tab__label" />
                </ui:VisualElement>
                <ui:VisualElement name="tabGraphics" class="settings-tab settings-tab--2">
                    <ui:Label text="GRAPHICS" picking-mode="Ignore" class="settings-tab__label" />
                </ui:VisualElement>
                <ui:VisualElement name="tabControls" class="settings-tab settings-tab--3">
                    <ui:Label text="CONTROLS" picking-mode="Ignore" class="settings-tab__label" />
                </ui:VisualElement>
                <ui:VisualElement name="tabLanguage" class="settings-tab settings-tab--4">
                    <ui:Label text="LANGUAGE" picking-mode="Ignore" class="settings-tab__label" />
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="settings__divider" />

                <ui:VisualElement name="audioPage" picking-mode="Ignore" class="settings__page">
                    <SettingsSlider name="masterSlider" label="MASTER VOLUME" value="80" class="settings-row--cyan" />
                    <SettingsSlider name="musicSlider" label="MUSIC" value="65" class="settings-row--white" />
                    <SettingsSlider name="sfxSlider" label="SOUND EFFECTS" value="90" class="settings-row--cyan" />
                    <SettingsSlider name="voiceSlider" label="VOICE" value="70" class="settings-row--white" />
                    <SettingsSelector name="voiceLanguageSelector" label="VOICE LANGUAGE" options="JAPANESE,ENGLISH,VIETNAMESE" index="0" class="settings-row--cyan" />
                    <SettingsToggle name="vibrationToggle" label="VIBRATION" value="true" class="settings-row--white" />
                    <SettingsToggle name="muteBackgroundToggle" label="MUTE IN BACKGROUND" value="false" class="settings-row--cyan" />
                </ui:VisualElement>

                <ui:VisualElement name="logoutButton" class="settings__btn settings__btn--logout">
                    <ui:Label text="LOGOUT" picking-mode="Ignore" class="settings__btn-label" />
                </ui:VisualElement>
                <ui:VisualElement name="resetButton" class="settings__btn settings__btn--reset">
                    <ui:Label text="RESET" picking-mode="Ignore" class="settings__btn-label" />
                </ui:VisualElement>
                <ui:VisualElement name="applyButton" class="settings__btn settings__btn--apply">
                    <ui:Label text="APPLY" picking-mode="Ignore" class="settings__btn-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="backHint" class="settings__hint settings__hint--back">
                <ui:VisualElement picking-mode="Ignore" class="settings__key settings__key--esc">
                    <ui:Label text="ESC" picking-mode="Ignore" class="settings__key-label" />
                </ui:VisualElement>
                <ui:Label text="BACK" picking-mode="Ignore" class="settings__hint-label" />
            </ui:VisualElement>
            <ui:VisualElement name="resetDefaultHint" class="settings__hint settings__hint--reset">
                <ui:VisualElement picking-mode="Ignore" class="settings__key settings__key--f">
                    <ui:Label text="F" picking-mode="Ignore" class="settings__key-label" />
                </ui:VisualElement>
                <ui:Label text="RESET DEFAULT" picking-mode="Ignore" class="settings__hint-label" />
            </ui:VisualElement>
        </SafeAreaContainer>

        <ui:VisualElement name="logoutDialog" class="settings-dialog settings-dialog--hidden">
            <ui:VisualElement class="settings-dialog__box">
                <ui:VisualElement picking-mode="Ignore" class="settings__accent settings__accent--yellow" />
                <ui:VisualElement picking-mode="Ignore" class="settings__accent settings__accent--cyan" />
                <ui:Label text="LOG OUT?" picking-mode="Ignore" class="settings-dialog__title" />
                <ui:Label name="logoutMessage" text="Your progress is saved to your account. You will return to the login screen." picking-mode="Ignore" class="settings-dialog__message" />
                <ui:VisualElement picking-mode="Ignore" class="settings-dialog__row">
                    <ui:VisualElement name="logoutCancelButton" class="settings__btn settings-dialog__btn settings-dialog__btn--cancel">
                        <ui:Label text="CANCEL" picking-mode="Ignore" class="settings__btn-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="logoutConfirmButton" class="settings__btn settings-dialog__btn settings-dialog__btn--confirm">
                        <ui:Label name="logoutConfirmLabel" text="LOGOUT" picking-mode="Ignore" class="settings__btn-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
>>>>>>> 37157e669918c4508205c48129ff513621872283:Assets/UI Toolkit/Screens/Settings/Settings.uxml
