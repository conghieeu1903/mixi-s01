<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../../Common/Wireframe.uss" />
    <ui:Style src="Settings.uss" />
    <ui:VisualElement name="settings" class="wf-screen settings">
        <ui:VisualElement name="settingsPanel" class="wf-panel settings__panel">
            <ui:VisualElement class="wf-panel__header">
                <ui:Label text="Settings" class="wf-heading wf-grow" />
                <ui:Label text="SettingsMenu" class="wf-note" />
            </ui:VisualElement>
            <ui:VisualElement name="tabs" class="settings__tabs">
                <ui:Button name="graphicsTab" text="Đồ họa" class="wf-tab wf-tab--active" />
                <ui:Button name="audioTab" text="Âm thanh" class="wf-tab" />
                <ui:Button name="controlsTab" text="Điều khiển" class="wf-tab" />
                <ui:Button name="languageTab" text="Ngôn ngữ" class="wf-tab" />
            </ui:VisualElement>
            <ui:ScrollView name="settingsList" class="settings__list">
                <ui:Label text="Hiển thị" class="wf-subheading settings__group" />
                <ui:DropdownField name="resolutionField" label="Độ phân giải" choices="1920 x 1080,1600 x 900,1280 x 720" index="0" class="settings__row" />
                <ui:Toggle name="fullscreenToggle" label="Toàn màn hình" value="true" class="settings__row" />
                <ui:Toggle name="vsyncToggle" label="VSync" class="settings__row" />
                <ui:DropdownField name="qualityField" label="Chất lượng" choices="Thấp,Trung bình,Cao,Rất cao" index="2" class="settings__row" />
                <ui:Slider name="fovSlider" label="FOV" low-value="60" high-value="110" value="80" show-input-field="true" class="settings__row" />
                <ui:Label text="Âm thanh" class="wf-subheading settings__group" />
                <ui:Slider name="masterSlider" label="Master" low-value="0" high-value="100" value="80" show-input-field="true" class="settings__row" />
                <ui:Slider name="musicSlider" label="Nhạc" low-value="0" high-value="100" value="60" show-input-field="true" class="settings__row" />
                <ui:Slider name="sfxSlider" label="Hiệu ứng" low-value="0" high-value="100" value="70" show-input-field="true" class="settings__row" />
                <ui:Label text="Điều khiển" class="wf-subheading settings__group" />
                <ui:Slider name="sensitivitySlider" label="Độ nhạy chuột" low-value="0.1" high-value="5" value="1.5" show-input-field="true" class="settings__row" />
                <ui:Toggle name="invertYToggle" label="Đảo trục Y" class="settings__row" />
            </ui:ScrollView>
            <ui:VisualElement class="settings__footer">
                <ui:Button name="defaultButton" text="Mặc định" class="wf-button" />
                <ui:VisualElement class="wf-grow" />
                <ui:Button name="backButton" text="Quay lại" class="wf-button" />
                <ui:Button name="applyButton" text="Áp dụng" class="wf-button wf-button--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
