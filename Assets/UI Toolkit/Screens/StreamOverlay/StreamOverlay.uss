.stream__top-info {
    position: absolute;
    left: 24px;
    top: 24px;
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
}

.stream__stat {
    margin-left: 28px;
}

.stream__chat {
    position: absolute;
    top: 24px;
    right: 24px;
    bottom: 96px;
    width: 420px;
    padding: 0;
}

.stream__chat-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    border-bottom-width: 2px;
    border-color: var(--wf-line-soft);
}

.stream__chat-list {
    flex-grow: 1;
    padding: 12px 16px;
    justify-content: flex-end;
}

.stream__chat-line {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.stream__chat-user {
    -unity-font-style: bold;
    margin-right: 6px;
}

.stream__chat-line--donate {
    padding: 8px;
    background-color: var(--wf-fill);
    border-radius: 4px;
}

.stream__donate {
    position: absolute;
    top: 140px;
    left: 560px;
    width: 640px;
    align-items: center;
}

.stream__donate-image {
    width: 160px;
    height: 160px;
    margin-bottom: 12px;
}

.stream__donate-message {
    margin: 8px 0 16px 0;
    -unity-text-align: middle-center;
}

.stream__donate-progress {
    align-self: stretch;
}

.stream__donate-progress-label {
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.stream__info-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 64px;
    flex-direction: row;
    align-items: center;
    padding: 0 24px;
    background-color: var(--wf-surface);
    border-top-width: 2px;
    border-color: var(--wf-line);
}

.stream__info-bar > .wf-text {
    margin-left: 16px;
}
