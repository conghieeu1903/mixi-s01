<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="Login.uss" />

    <ui:VisualElement name="loginRoot" class="login">
        <ui:VisualElement name="loginDim" picking-mode="Ignore" class="login__dim" />

        <SafeAreaContainer name="loginSafeArea">
            <ui:VisualElement name="loginPanel" class="login__panel">
                <ui:VisualElement picking-mode="Ignore" class="login__accent login__accent--yellow" />
                <ui:VisualElement picking-mode="Ignore" class="login__accent login__accent--cyan" />

                <ui:Label name="loginTitle" text="WELCOME" picking-mode="Ignore" class="login__title" />
                <ui:Label name="loginSubtitle" text="SIGN IN TO KEEP YOUR PROGRESS" picking-mode="Ignore" class="login__subtitle" />

                <ui:VisualElement name="tabRow" picking-mode="Ignore" class="login__tabs">
                    <ui:VisualElement name="tabLogin" class="login-tab login-tab--active">
                        <ui:Label text="LOGIN" picking-mode="Ignore" class="login-tab__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="tabRegister" class="login-tab">
                        <ui:Label text="REGISTER" picking-mode="Ignore" class="login-tab__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="login__divider" />

                <ui:VisualElement name="loginPage" picking-mode="Ignore" class="login__page">
                    <ui:Label text="USERNAME" picking-mode="Ignore" class="login__field-label" />
                    <ui:TextField name="loginUsername" max-length="32" placeholder-text="Enter your username" class="login__field" />
                    <ui:Label text="PASSWORD" picking-mode="Ignore" class="login__field-label" />
                    <ui:TextField name="loginPassword" max-length="64" password="true" placeholder-text="Enter your password" class="login__field" />
                </ui:VisualElement>

                <ui:VisualElement name="registerPage" picking-mode="Ignore" class="login__page login__page--hidden">
                    <ui:Label text="EMAIL" picking-mode="Ignore" class="login__field-label" />
                    <ui:TextField name="registerEmail" max-length="64" placeholder-text="you@example.com" class="login__field" />
                    <ui:Label text="USERNAME" picking-mode="Ignore" class="login__field-label" />
                    <ui:TextField name="registerUsername" max-length="32" placeholder-text="3-32 characters" class="login__field" />
                    <ui:Label text="PASSWORD" picking-mode="Ignore" class="login__field-label" />
                    <ui:TextField name="registerPassword" max-length="64" password="true" placeholder-text="At least 6 characters" class="login__field" />
                </ui:VisualElement>

                <ui:Label name="statusLabel" text="" picking-mode="Ignore" class="login__status" />

                <ui:VisualElement name="submitButton" class="login__btn login__btn--submit">
                    <ui:Label name="submitLabel" text="LOGIN" picking-mode="Ignore" class="login__btn-label" />
                </ui:VisualElement>

                <ui:VisualElement name="altRow" picking-mode="Ignore" class="login__alt">
                    <ui:VisualElement name="guestButton" class="login__btn login__btn--alt login__btn--hidden">
                        <ui:Label text="PLAY AS GUEST" picking-mode="Ignore" class="login__btn-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="googleButton" class="login__btn login__btn--alt">
                        <ui:Label name="googleLabel" text="GOOGLE" picking-mode="Ignore" class="login__btn-label" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="successPanel" class="login__success login__success--hidden">
                    <ui:VisualElement picking-mode="Ignore" class="login__success-badge">
                        <ui:VisualElement picking-mode="Ignore" class="login__success-check" />
                    </ui:VisualElement>
                    <ui:Label text="ACCOUNT CREATED!" picking-mode="Ignore" class="login__title login__success-title" />
                    <ui:Label name="successMessage" text="Welcome, player!" picking-mode="Ignore" class="login__success-message" />
                    <ui:Label text="Your progress will be saved to this account." picking-mode="Ignore" class="login__subtitle login__success-note" />
                    <ui:VisualElement name="continueButton" class="login__btn login__btn--submit login__success-btn">
                        <ui:Label text="CONTINUE" picking-mode="Ignore" class="login__btn-label" />
                    </ui:VisualElement>
                </ui:VisualElement>            </ui:VisualElement>
        </SafeAreaContainer>
    </ui:VisualElement>
</ui:UXML>
