.world-panel {
    width: 440px;
    height: 400px;
}

.wf-screen .world-panel .unity-base-field__label {
    min-width: 120px;
}

.world-panel__row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-color: var(--wf-line-soft);
}

.world-panel__row-name {
    width: 110px;
}

.world-panel__row-value {
    flex-grow: 1;
    flex-shrink: 1;
}

.world-panel__row > .wf-icon {
    margin-right: 12px;
}

.world-panel__footer {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.world-panel__footer > .wf-button {
    margin-left: 10px;
}

.world-panel__swatches {
    flex-direction: row;
    flex-wrap: wrap;
}

.world-panel__swatch {
    width: 72px;
    height: 72px;
    margin: 0 12px 12px 0;
    border-width: 2px;
    border-color: var(--wf-line);
    border-radius: 6px;
}

.world-panel__swatch--selected {
    border-width: 4px;
    border-color: var(--wf-ink);
}

.world-panel__swatch--1 {
    background-color: rgb(245, 245, 245);
}

.world-panel__swatch--2 {
    background-color: rgb(220, 220, 220);
}

.world-panel__swatch--3 {
    background-color: rgb(195, 195, 195);
}

.world-panel__swatch--4 {
    background-color: rgb(170, 170, 170);
}

.world-panel__swatch--5 {
    background-color: rgb(145, 145, 145);
}

.world-panel__swatch--6 {
    background-color: rgb(120, 120, 120);
}

.world-panel__swatch--7 {
    background-color: rgb(95, 95, 95);
}

.world-panel__swatch--8 {
    background-color: rgb(70, 70, 70);
}

.world-panel__options {
    flex-direction: row;
    flex-wrap: wrap;
}

.world-panel__option {
    width: 120px;
    margin: 0 12px 12px 0;
}

.world-panel__preview {
    height: 140px;
    margin-bottom: 12px;
}
