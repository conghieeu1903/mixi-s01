.hud__crosshair-area {
    align-items: center;
    justify-content: center;
}

.hud__crosshair {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--wf-surface);
    border-width: 2px;
    border-color: var(--wf-ink);
}

.hud__item-name {
    position: absolute;
    top: 560px;
    -unity-font-style: bold;
    background-color: rgba(250, 250, 250, 0.85);
    padding: 4px 12px;
    border-radius: 4px;
}

.hud__status {
    position: absolute;
    left: 40px;
    top: 32px;
    min-width: 240px;
    padding: 12px 18px;
}

.hud__status-row {
    justify-content: space-between;
    margin-bottom: 4px;
}

.hud__day {
    margin-right: 16px;
}

.hud__clock {
    color: var(--wf-ink);
}

.hud__money {
    margin-bottom: 4px;
}

.hud__warning {
    position: absolute;
    top: 120px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    padding: 14px 24px;
}

.hud__warning-icon {
    margin-right: 12px;
}

.hud__notify {
    position: absolute;
    top: 32px;
    right: 40px;
    flex-direction: row;
}

.hud__notify-item {
    margin-left: 20px;
    align-items: center;
}

.hud__notify-item > .wf-caption {
    margin-top: 4px;
}

.hud__skill-toast {
    position: absolute;
    top: 160px;
    right: 40px;
    width: 340px;
    flex-direction: row;
    align-items: center;
    padding: 14px;
}

.hud__skill-toast-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
}

.hud__held-item {
    position: absolute;
    left: 40px;
    bottom: 40px;
    flex-direction: row;
    align-items: center;
    padding: 12px;
}

.hud__held-item-text {
    margin-left: 12px;
}

.hud__hints {
    position: absolute;
    right: 40px;
    bottom: 40px;
    align-items: flex-end;
}

.hud__hint {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding: 6px 10px;
    background-color: rgba(250, 250, 250, 0.85);
    border-radius: 4px;
}

.hud__hint > .wf-text {
    margin-left: 10px;
}

.hud__context-hints {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 140px;
    flex-direction: row;
    justify-content: center;
}

.hud__context-hint {
    flex-direction: row;
    align-items: center;
    margin: 0 10px;
    padding: 6px 10px;
    background-color: rgba(250, 250, 250, 0.85);
    border-radius: 4px;
}

.hud__context-hint > .wf-caption {
    margin-left: 8px;
    color: var(--wf-ink);
}

.hud__bottom-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    align-items: center;
}

.hud__info-line {
    padding: 6px 16px;
    margin-top: 6px;
    background-color: rgba(250, 250, 250, 0.85);
    border-left-width: 6px;
    border-color: var(--wf-line);
    border-radius: 4px;
}

.hud__info-line--positive {
    border-color: var(--wf-ink);
}

.hud__fader-note {
    position: absolute;
    left: 40px;
    top: 170px;
}
