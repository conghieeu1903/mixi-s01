.inventory__panel {
    width: 1280px;
    height: 760px;
}

.inventory__body {
    flex-grow: 1;
    flex-direction: row;
}

.inventory__grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.inventory__slot {
    width: 120px;
    height: 120px;
    margin: 0 12px 12px 0;
}

.inventory__slot--selected {
    border-width: 3px;
    border-color: var(--wf-ink);
}

.inventory__slot--empty {
    background-color: var(--wf-surface);
    border-color: var(--wf-line-soft);
}

.inventory__detail {
    width: 340px;
    margin-left: 16px;
    padding-left: 24px;
    border-left-width: 2px;
    border-color: var(--wf-line-soft);
}

.inventory__detail-image {
    height: 220px;
    margin-bottom: 16px;
}

.inventory__detail-desc {
    margin: 8px 0 16px 0;
}

.inventory__detail-button {
    margin-top: 12px;
}
