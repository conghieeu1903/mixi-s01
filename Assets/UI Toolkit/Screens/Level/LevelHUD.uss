.level-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.level-hud__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 320;
    -unity-slice-top: 170;
    -unity-slice-right: 40;
    -unity-slice-bottom: 40;
}

.level-hud__text {
    position: absolute;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/Arts/Fonts/Inter/Inter-BlackItalic%20SDF.asset?fileID=11400000&guid=6760fe27ba215f04189cb6a412f07c16&type=2#Inter-BlackItalic SDF");
}

/* Góc trên trái: nút back và tên level */
.level-hud__back-btn {
    position: absolute;
    left: 16px;
    top: 10px;
    width: 191px;
    height: 148px;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_back_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-duration: 0.1s;
}

.level-hud__back-btn:hover {
    scale: 1.05 1.05;
}

.level-hud__back-btn:active {
    scale: 0.95 0.95;
}

.level-hud__back-icon {
    position: absolute;
    left: 56px;
    top: 42px;
    width: 64px;
    height: 64px;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_icon_back.png");
    -unity-background-scale-mode: scale-to-fit;
}

.level-hud__title {
    left: 220px;
    top: 34px;
    font-size: 64px;
    letter-spacing: 0.6px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 9px;
    -unity-text-outline-color: rgb(2, 11, 46);
}

.level-hud__subtitle {
    left: 227px;
    top: 96px;
    width: 300px;
    height: 34px;
    font-size: 28px;
    letter-spacing: 1.1px;
    color: rgb(34, 211, 238);
    rotate: -6deg;
    -unity-text-align: middle-center;
}

/* Góc trên phải: tiền tệ và cài đặt */
.level-hud__top-bar {
    position: absolute;
    right: 70px;
    top: 28px;
    height: 96px;
    flex-direction: row;
    align-items: center;
}

.level-hud__pill--coins {
    margin-right: 38px;
}

.level-hud__pill--diamonds {
    margin-right: 50px;
}

.level-hud__settings-btn {
    width: 80px;
    height: 80px;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_icon_settings.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.15s;
}

.level-hud__settings-btn:hover {
    rotate: 30deg;
}

.level-hud__settings-btn:active {
    scale: 0.92 0.92;
}

/* Thanh dưới: dừng, quay, tự quay, bingo */
.level-hud__bottom-bar {
    position: absolute;
    left: 76px;
    top: 906px;
    width: 1378px;
    height: 168px;
    background-image: url("/Assets/Arts/Sprites/Level/level_bottom_bar.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.level-hud__stop {
    position: absolute;
    left: 335px;
    top: 947px;
    width: 265px;
    height: 93px;
    background-image: url("/Assets/Arts/Sprites/Level/level_btn_stop.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-duration: 0.1s;
}

.level-hud__stop:hover {
    scale: 1.04 1.04;
}

.level-hud__stop:active {
    scale: 0.96 0.96;
}

.level-hud__stop--disabled {
    opacity: 0.45;
}

.level-hud__stop-label {
    left: 0;
    right: 0;
    top: 16px;
    font-size: 40px;
    letter-spacing: 0.4px;
    color: rgb(2, 11, 46);
    -unity-text-align: upper-center;
}

.level-hud__spin {
    position: absolute;
    left: 556px;
    top: 924px;
    width: 418px;
    height: 147px;
    background-image: url("/Assets/Arts/Sprites/Level/level_btn_spin.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-duration: 0.1s;
}

.level-hud__spin:hover {
    scale: 1.03 1.03;
}

.level-hud__spin:active {
    scale: 0.97 0.97;
}

.level-hud__spin--disabled {
    opacity: 0.6;
}

.level-hud__spin-label {
    left: 0;
    right: 0;
    top: 16px;
    font-size: 76px;
    letter-spacing: 0.8px;
    color: rgb(2, 11, 46);
    -unity-text-align: upper-center;
}

.level-hud__auto {
    position: absolute;
    left: 928px;
    top: 947px;
    width: 265px;
    height: 93px;
    background-image: url("/Assets/Arts/Sprites/Level/level_btn_auto.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-duration: 0.1s;
}

.level-hud__auto:hover {
    scale: 1.04 1.04;
}

.level-hud__auto:active {
    scale: 0.96 0.96;
}

.level-hud__auto--active {
    -unity-background-image-tint-color: rgb(255, 236, 140);
}

.level-hud__auto-label {
    left: 0;
    right: 0;
    top: 16px;
    font-size: 40px;
    letter-spacing: 0.4px;
    color: rgb(2, 11, 46);
    -unity-text-align: upper-center;
}

.level-hud__bingo-crown {
    position: absolute;
    left: 1220px;
    top: 960px;
    width: 60px;
    height: 60px;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_icon_crown.png");
    -unity-background-scale-mode: scale-to-fit;
}

.level-hud__bingo-value {
    left: 1290px;
    top: 953px;
    font-size: 44px;
    letter-spacing: 0.4px;
    color: rgb(255, 210, 63);
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: rgb(2, 11, 46);
}

.level-hud__bingo-label {
    left: 1300px;
    top: 999px;
    width: 82px;
    height: 29px;
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(34, 211, 238);
    rotate: -6deg;
    -unity-text-align: middle-center;
}

/* Khẩu hiệu góc dưới phải */
.level-hud__good-luck {
    right: -1px;
    top: 854px;
    width: 418px;
    height: 77px;
    font-size: 64px;
    letter-spacing: 0.6px;
    color: rgb(255, 255, 255);
    rotate: -7deg;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 9px;
    -unity-text-outline-color: rgb(2, 11, 46);
}

/* Bảng qua màn: hiện khi thắng, chờ người chơi bấm NEXT */
.level-complete {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 11, 46, 0.78);
    opacity: 0;
    transition-duration: 0.25s;
}

.level-complete--shown {
    display: flex;
}

.level-complete--open {
    opacity: 1;
}

.level-complete__panel {
    width: 860px;
    height: 650px;
    align-items: center;
    justify-content: center;
    padding: 30px 90px 40px 90px;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_list_panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    scale: 0.7 0.7;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.level-complete--open .level-complete__panel {
    scale: 1 1;
}

.level-complete__text {
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Arts/Fonts/Inter/Inter-BlackItalic%20SDF.asset?fileID=11400000&guid=6760fe27ba215f04189cb6a412f07c16&type=2#Inter-BlackItalic SDF");
}

.level-complete__crown {
    width: 120px;
    height: 120px;
    margin-top: -100px;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_icon_crown.png");
    -unity-background-scale-mode: scale-to-fit;
}

.level-complete__title {
    font-size: 72px;
    letter-spacing: 0.6px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 9px;
    -unity-text-outline-color: rgb(2, 11, 46);
}

.level-complete__headline {
    font-size: 60px;
    letter-spacing: 0.6px;
    color: rgb(255, 210, 63);
    rotate: -5deg;
    -unity-text-outline-width: 9px;
    -unity-text-outline-color: rgb(2, 11, 46);
}

.level-complete__banner {
    width: 460px;
    height: 96px;
    margin-top: 12px;
    justify-content: center;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_subtitle_banner.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.level-complete__outcome {
    font-size: 40px;
    letter-spacing: 1.2px;
    color: rgb(34, 211, 238);
    rotate: -5deg;
}

.level-complete__reward {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.level-complete__coin {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    background-image: url("/Assets/Arts/Sprites/Shop/shop_icon_coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.level-complete__reward-value {
    font-size: 56px;
    color: rgb(255, 210, 63);
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: rgb(2, 11, 46);
}

.level-complete__next {
    margin-top: 4px;
    font-size: 26px;
    letter-spacing: 1.1px;
    color: rgb(255, 255, 255);
}

.level-complete__buttons {
    flex-direction: row;
    align-items: center;
    margin-top: 22px;
}

.level-complete__menu-btn {
    width: 230px;
    height: 81px;
    margin-right: 28px;
    justify-content: center;
    padding-bottom: 8px;
    background-image: url("/Assets/Arts/Sprites/Level/level_btn_stop.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-duration: 0.1s;
}

.level-complete__menu-btn:hover {
    scale: 1.04 1.04;
}

.level-complete__menu-btn:active {
    scale: 0.96 0.96;
}

.level-complete__menu-label {
    font-size: 36px;
    letter-spacing: 0.4px;
    color: rgb(2, 11, 46);
}

.level-complete__next-btn {
    width: 340px;
    height: 120px;
    justify-content: center;
    padding-bottom: 12px;
    background-image: url("/Assets/Arts/Sprites/Level/level_btn_spin.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-duration: 0.1s;
}

.level-complete__next-btn:hover {
    scale: 1.04 1.04;
}

.level-complete__next-btn:active {
    scale: 0.96 0.96;
}

.level-complete__next-label {
    font-size: 64px;
    letter-spacing: 0.8px;
    color: rgb(2, 11, 46);
}

.level-hud__settings-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}
