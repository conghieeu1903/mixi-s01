.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(1, 21, 69);
}

.menu__bg,
.menu__overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.menu__bg {
    background-image: url("/Assets/Arts/Sprites/Menu/menu_bg.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

.menu__overlay {
    background-image: url("/Assets/Arts/Sprites/Menu/menu_overlay.png");
    -unity-background-scale-mode: stretch-to-fill;
}

