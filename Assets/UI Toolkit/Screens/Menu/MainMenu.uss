/* Nút tròn Quest và điểm danh trên thanh trên cùng */
.menu__icon-btn {
    width: 88px;
    height: 88px;
    margin-right: 30px;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 18, 56);
    border-width: 3px;
    border-color: rgb(253, 206, 3);
    border-radius: 44px;
    transition-duration: 0.15s;
}

.menu__icon-btn:hover {
    scale: 1.06 1.06;
}

.menu__icon-btn:active {
    scale: 0.92 0.92;
}

.menu__icon-btn-icon {
    width: 60px;
    height: 60px;
    -unity-background-scale-mode: scale-to-fit;
}

.menu__icon-btn--daily > .menu__icon-btn-icon {
    background-image: url("/Assets/Arts/Sprites/Icons/icon_money_bag.png");
}

.menu__icon-btn--quest {
