    height: 28px;
    background-color: rgb(239, 68, 68);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    border-radius: 14px;
    display: none;
}

.menu__icon-btn--ready > .menu__icon-btn-badge {
