.main-menu__world {
    padding-left: 520px;
}

.main-menu__sidebar {
    position: absolute;
    left: 80px;
    top: 80px;
    bottom: 80px;
    width: 440px;
}

.main-menu__logo {
    height: 200px;
    margin-bottom: 40px;
}

.main-menu__button {
    height: 68px;
    font-size: 26px;
    margin-bottom: 16px;
}

.main-menu__dialog {
    width: 560px;
}

.main-menu__dialog-text {
    margin-bottom: 20px;
}

.main-menu__save-info {
    margin-bottom: 24px;
}

.main-menu__save-thumb {
    width: 160px;
    height: 90px;
    margin-right: 16px;
}

.main-menu__dialog-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.main-menu__dialog-actions > .wf-button {
    margin-left: 12px;
}

.main-menu__progress {
    margin-bottom: 12px;
}
