<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="LevelSelect" src="project://database/Assets/UI/Screens/LevelSelect/LevelSelect.uxml?fileID=9197481963319205126&amp;guid=43381bf527924b3586c29dbe1a9a561f&amp;type=3#LevelSelect"/>
    <ui:Template name="Shop" src="project://database/Assets/UI/Screens/Shop/Shop.uxml?fileID=9197481963319205126&amp;guid=d1e381e0226e15c469a877ed26b2e179&amp;type=3#Shop"/>
    <ui:Template name="Settings" src="../Settings/Settings.uxml" />
    <ui:Template name="DailyReward" src="../DailyReward/DailyReward.uxml" />
    <ui:Template name="Quest" src="../Quest/Quest.uxml" />
    <Style src="project://database/Assets/UI/Components/StrokeText/StrokeText.uss?fileID=7433441132597879392&amp;guid=1228099b32071fe43b8cd0b0308d410b&amp;type=3#StrokeText"/>
    <Style src="project://database/Assets/UI/Components/CurrencyPill/CurrencyPill.uss?fileID=7433441132597879392&amp;guid=1f1f643e42ffbba49a61b039d79777e1&amp;type=3#CurrencyPill"/>
    <Style src="project://database/Assets/UI/Screens/Menu/MainMenu.uss?fileID=7433441132597879392&amp;guid=4f4a5ef66381dc44c8d7277e9c781fbf&amp;type=3#MainMenu"/>
    <ui:VisualElement name="menuRoot" class="menu">
        <ui:VisualElement name="menuBg" picking-mode="Ignore" class="menu__bg"/>
        <ui:VisualElement name="menuOverlay" picking-mode="Ignore" class="menu__overlay"/>
        <ui:VisualElement name="menuCharacter" picking-mode="Ignore" class="menu__character"/>
        <SafeAreaContainer name="menuSafeArea">
            <ui:VisualElement name="playerBadge" class="menu__player">
                <ui:VisualElement name="playerAvatar" picking-mode="Ignore" class="menu__player-avatar"/>
                <ui:Label name="playerNameLabel" text="Player01" picking-mode="Ignore" class="menu__text menu__player-name"/>
            </ui:VisualElement>
            <ui:VisualElement name="topBar" picking-mode="Ignore" enabled="true" class="menu__top-bar">
                <ui:VisualElement name="questButton" class="menu__icon-btn menu__icon-btn--quest">
                    <ui:VisualElement picking-mode="Ignore" class="menu__icon-btn-icon"/>
                    <ui:VisualElement name="questBadge" picking-mode="Ignore" class="menu__icon-btn-badge"/>
                </ui:VisualElement>
                <ui:VisualElement name="dailyButton" class="menu__icon-btn menu__icon-btn--daily">
                    <ui:VisualElement picking-mode="Ignore" class="menu__icon-btn-icon"/>
                    <ui:VisualElement name="dailyBadge" picking-mode="Ignore" class="menu__icon-btn-badge"/>
                </ui:VisualElement>
                <CurrencyPill name="coinsPill" currency-type="Coins" value="1,250" class="menu__currency-pill--coins"/>
                <CurrencyPill name="diamondsPill" currency-type="Diamonds" value="50" class="menu__currency-pill--diamonds"/>
                <ui:VisualElement name="topSettingsButton" class="menu__settings-btn"/>
            </ui:VisualElement>
            <ui:VisualElement name="logoCrown" picking-mode="Ignore" class="menu__logo-crown"/>
            <ui:VisualElement name="logoSg02" picking-mode="Ignore" class="menu__logo-sg02"/>
            <ui:VisualElement name="logoArena" picking-mode="Ignore" class="menu__logo-arena"/>
            <ui:VisualElement name="taglineBanner" picking-mode="Ignore" class="menu__tagline-banner"/>
            <ui:Label name="taglineLabel" text="PLAY · MATCH · WIN" picking-mode="Ignore" class="menu__text menu__tagline"/>
            <ui:VisualElement name="actionColumn" picking-mode="Ignore" class="menu__actions">
                <ui:VisualElement name="startButton" class="menu-btn menu-btn--start">
                    <ui:VisualElement picking-mode="Ignore" class="menu-btn__icon"/>
                    <ui:Label text="START" picking-mode="Ignore" class="menu__text menu-btn__title"/>
                    <ui:Label text="PLAY NOW" picking-mode="Ignore" class="menu__text menu-btn__subtitle"/>
                    <ui:VisualElement picking-mode="Ignore" class="menu-btn__chevron"/>
                </ui:VisualElement>
                <ui:VisualElement name="optionsButton" class="menu-btn menu-btn--options">
                    <ui:VisualElement picking-mode="Ignore" class="menu-btn__icon"/>
                    <ui:Label text="OPTIONS" picking-mode="Ignore" class="menu__text menu-btn__title"/>
                    <ui:Label text="SETTINGS" picking-mode="Ignore" class="menu__text menu-btn__subtitle"/>
                </ui:VisualElement>
                <ui:VisualElement name="shopButton" class="menu-btn menu-btn--shop">
                    <ui:VisualElement picking-mode="Ignore" class="menu-btn__icon"/>
                    <ui:Label text="SHOP" picking-mode="Ignore" class="menu__text menu-btn__title"/>
                    <ui:Label text="BUY &amp; EXCHANGE" picking-mode="Ignore" class="menu__text menu-btn__subtitle"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottomNav" picking-mode="Ignore" enabled="true" class="menu__nav-bg" style="display: none;"/>
            <ui:VisualElement picking-mode="Ignore" class="menu__nav-divider menu__nav-divider--1" style="display: none;"/>
            <ui:VisualElement picking-mode="Ignore" class="menu__nav-divider menu__nav-divider--2" style="display: none;"/>
            <ui:VisualElement picking-mode="Ignore" class="menu__nav-divider menu__nav-divider--3" style="display: none;"/>
            <ui:VisualElement name="navBar" picking-mode="Ignore" enabled="true" class="menu__nav" style="display: none;">
                <ui:VisualElement name="rankingButton" class="menu-nav-item menu-nav-item--ranking">
                    <ui:VisualElement picking-mode="Ignore" class="menu-nav-item__icon"/>
                    <ui:Label text="RANKING" picking-mode="Ignore" class="menu__text menu-nav-item__label"/>
                    <ui:VisualElement name="rankingBadge" picking-mode="Ignore" class="menu-nav-item__badge"/>
                </ui:VisualElement>
                <ui:VisualElement name="achievementsButton" class="menu-nav-item menu-nav-item--achievements">
                    <ui:VisualElement picking-mode="Ignore" class="menu-nav-item__icon"/>
                    <ui:Label text="ACHIEVEMENTS" picking-mode="Ignore" class="menu__text menu-nav-item__label"/>
                </ui:VisualElement>
                <ui:VisualElement name="missionButton" class="menu-nav-item menu-nav-item--mission">
                    <ui:VisualElement picking-mode="Ignore" class="menu-nav-item__icon"/>
                    <ui:Label text="MISSION" picking-mode="Ignore" class="menu__text menu-nav-item__label"/>
                    <ui:VisualElement name="missionBadge" picking-mode="Ignore" class="menu-nav-item__badge"/>
                </ui:VisualElement>
                <ui:VisualElement name="newsButton" class="menu-nav-item menu-nav-item--news">
                    <ui:VisualElement picking-mode="Ignore" class="menu-nav-item__icon"/>
                    <ui:Label text="NEWS" picking-mode="Ignore" class="menu__text menu-nav-item__label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="menuCallout" picking-mode="Ignore" class="menu__callout">
                <ui:VisualElement picking-mode="Ignore" class="menu__callout-crown"/>
                <StrokeText text="MORE PLAYS" picking-mode="Ignore" class="menu__text menu__callout-line menu__callout-line1"/>
                <StrokeText text="MORE REWARDS" picking-mode="Ignore" class="menu__text menu__callout-line menu__callout-line2"/>
            </ui:VisualElement>
        </SafeAreaContainer>
    </ui:VisualElement>
    <ui:Instance template="LevelSelect" name="levelSelect" picking-mode="Ignore" class="subscreen-container"/>
    <ui:Instance template="Shop" name="shopScreen" picking-mode="Ignore" class="subscreen-container"/>
    <ui:Instance template="Settings" name="settingsScreen" picking-mode="Ignore" class="subscreen-container"/>
    <ui:Instance template="Quest" name="questScreen" picking-mode="Ignore" class="subscreen-container"/>
    <ui:Instance template="DailyReward" name="dailyRewardScreen" picking-mode="Ignore" class="subscreen-container"/>
</ui:UXML>
