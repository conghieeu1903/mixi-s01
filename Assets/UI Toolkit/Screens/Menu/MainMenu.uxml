<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../../Common/Wireframe.uss" />
    <ui:Style src="MainMenu.uss" />
    <ui:VisualElement name="mainMenu" class="wf-screen">
        <ui:VisualElement name="background" class="wf-world main-menu__world">
            <ui:Label text="BACKGROUND 3D – PHÒNG STREAMER" class="wf-world__label" />
        </ui:VisualElement>
        <ui:VisualElement name="sidebar" class="wf-panel main-menu__sidebar">
            <ui:VisualElement name="logo" class="wf-placeholder main-menu__logo">
                <ui:Label text="LOGO GAME" class="wf-placeholder__label" />
            </ui:VisualElement>
            <ui:Button name="playButton" text="Chơi" class="wf-button wf-button--primary main-menu__button" />
            <ui:Button name="settingsButton" text="Settings" class="wf-button main-menu__button" />
            <ui:Button name="exitButton" text="Thoát" class="wf-button main-menu__button" />
            <ui:VisualElement class="wf-grow" />
            <ui:Label text="v0.1 · MenuManager" class="wf-note" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
